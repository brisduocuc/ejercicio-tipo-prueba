<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18.0" prefWidth="680.0" prefHeight="640.0"
      style="-fx-background-color: #f4f6f9; -fx-font-family: 'Segoe UI', Arial, sans-serif;"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo1.HelloController">

    <padding>
        <Insets top="24.0" right="28.0" bottom="24.0" left="28.0" />
    </padding>

    <!-- Encabezado -->
    <VBox spacing="4.0">
        <Label text="Gestión de Talleres — Estación Sur"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
        <Label text="Registra o administra los talleres presenciales y virtuales."
               style="-fx-font-size: 13px; -fx-text-fill: #64748b;" />
    </VBox>

    <!-- Tarjeta del Formulario -->
    <VBox spacing="16.0" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
        <padding>
            <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
        </padding>

        <!-- Selector de Modalidad -->
        <HBox spacing="24.0" alignment="CENTER_LEFT" style="-fx-padding: 0 0 6 0; -fx-border-color: transparent transparent #f1f5f9 transparent;">
            <fx:define>
                <ToggleGroup fx:id="modalidadGroup" />
            </fx:define>
            <Label text="Modalidad:" style="-fx-font-weight: bold; -fx-text-fill: #334155;" />
            <RadioButton fx:id="rbPresencial" text="Taller Presencial" toggleGroup="$modalidadGroup" selected="true" style="-fx-text-fill: #334155;" />
            <RadioButton fx:id="rbVirtual" text="Taller Virtual" toggleGroup="$modalidadGroup" style="-fx-text-fill: #334155;" />
        </HBox>

        <!-- Campos en Cuadrícula (2 Columnas) -->
        <GridPane hgap="16.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints minWidth="105.0" prefWidth="110.0" />
                <ColumnConstraints hgrow="ALWAYS" prefWidth="180.0" />
                <ColumnConstraints minWidth="105.0" prefWidth="110.0" />
                <ColumnConstraints hgrow="ALWAYS" prefWidth="180.0" />
            </columnConstraints>

            <!-- Fila 0 -->
            <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #475569; -fx-font-weight: bold;" />
            <TextField fx:id="txtCodigo" promptText="Ej. TAL-01" GridPane.columnIndex="1" GridPane.rowIndex="0"
                       style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-padding: 6 10;" />

            <Label text="Nombre:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-text-fill: #475569; -fx-font-weight: bold;" />
            <TextField fx:id="txtNombre" promptText="Nombre del taller" GridPane.columnIndex="3" GridPane.rowIndex="0"
                       style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-padding: 6 10;" />

            <!-- Fila 1 -->
            <Label text="Duración (hrs):" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #475569; -fx-font-weight: bold;" />
            <TextField fx:id="txtDuracion" promptText="Ej. 8" GridPane.columnIndex="1" GridPane.rowIndex="1"
                       style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-padding: 6 10;" />

            <Label text="Cupos:" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-text-fill: #475569; -fx-font-weight: bold;" />
            <TextField fx:id="txtCupos" promptText="Ej. 20" GridPane.columnIndex="3" GridPane.rowIndex="1"
                       style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-padding: 6 10;" />

            <!-- Fila 2: Campos específicos -->
            <Label text="Sala:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-text-fill: #475569; -fx-font-weight: bold;" />
            <TextField fx:id="txtSala" promptText="Ej. Sala 3B" GridPane.columnIndex="1" GridPane.rowIndex="2"
                       style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-padding: 6 10;" />

            <Label text="Plataforma:" GridPane.columnIndex="2" GridPane.rowIndex="2" style="-fx-text-fill: #475569; -fx-font-weight: bold;" />
            <TextField fx:id="txtPlataforma" promptText="Ej. Zoom / Meet" GridPane.columnIndex="3" GridPane.rowIndex="2"
                       style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-padding: 6 10;" />

            <!-- Fila 3: Opciones booleanas -->
            <CheckBox fx:id="chkMateriales" text="Materiales incluidos" GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-text-fill: #334155;" />
            <CheckBox fx:id="chkGrabacion" text="Grabación disponible" GridPane.columnIndex="3" GridPane.rowIndex="3" style="-fx-text-fill: #334155;" />
        </GridPane>

        <!-- Barra inferior de la tarjeta: Mensaje y Botones -->
        <HBox spacing="12.0" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0; -fx-border-color: #f1f5f9 transparent transparent transparent;">
            <Label fx:id="lblMensaje" text="Listo para registrar" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                   style="-fx-text-fill: #0284c7; -fx-font-size: 12px; -fx-font-weight: bold;" />
            <Button fx:id="btnEliminar" onAction="#onEliminarClick" text="Eliminar"
                    style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;" />
            <Button fx:id="btnRegistrar" onAction="#onHelloButtonClick" text="Registrar Taller"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 18; -fx-cursor: hand;" />
        </HBox>
    </VBox>

    <!-- Tabla de Resultados -->
    <TableView fx:id="tblTalleres" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colCodigo" prefWidth="90.0" text="Código" />
            <TableColumn fx:id="colNombre" prefWidth="260.0" text="Nombre" />
            <TableColumn fx:id="colDuracion" prefWidth="120.0" text="Duración (hrs)" />
            <TableColumn fx:id="colCupos" prefWidth="90.0" text="Cupos" />
        </columns>
    </TableView>

</VBox>